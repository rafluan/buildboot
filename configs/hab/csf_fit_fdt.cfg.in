[Header]
    Version = 4.3
    Hash Algorithm = sha256
    Engine = CAAM
    Engine Configuration = 0
    Certificate Format = X509
    Signature Format = CMS

[Install SRK]
    File = "@SRK_TABLE@"
    Source index = 0

[Install CSFK]
    File = "@CSFK_CERT@"

[Authenticate CSF]

[Unlock]
    Engine = CAAM
    Features = MID

[Install Key]
    Verification index = 0
    Target index = 2
    File = "@IMG_CERT@"

[Authenticate Data]
    Verification index = 2
    Blocks = @FIT_FDT_BLOCK@ "@FINAL_IMAGE@"
